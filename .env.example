# 로컬 개발 전용 값이다. 운영 환경에서 재사용하지 않는다.
DB_PORT=55432
DB_NAME=youth_policy_mate
DB_USER=youth_policy_mate
DB_PASSWORD=local-only-password

# 응답 점검과 한 페이지 수집에 사용한다. 실제 키를 저장소나 채팅에 남기지 않는다.
ONTONG_API_KEY=

# 소셜 로그인: 앱에 리다이렉트 주소를 등록한 뒤 설정한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
APP_FRONTEND_URL=http://127.0.0.1:3000
APP_BACKEND_URL=http://127.0.0.1:8080

# 서비스 내 알림의 로컬 확인 설정이다. 운영 설정은 별도로 정한다.
REMINDERS_ENABLED=true
REMINDER_DELIVERY_TIME=09:00
REMINDER_POLL_MS=60000

# 범위·정기 수집: 실제 계정 한도를 확인한 뒤 두 값을 함께 설정한다.
# 0은 미설정이다. 이 상태에서는 기존 수동 한 페이지 수집만 허용한다.
ONTONG_COLLECTION_DAILY_LIMIT=0
ONTONG_COLLECTION_INTERVAL_SECONDS=0

# 정기 수집은 기본 비활성화다. 시작·마지막 페이지와 완료 후 반복 간격을 모두 정해야 켤 수 있다.
ONTONG_COLLECTION_SCHEDULE_ENABLED=false
ONTONG_COLLECTION_FIRST_PAGE=0
ONTONG_COLLECTION_LAST_PAGE=0
ONTONG_COLLECTION_CYCLE_SECONDS=0

# 이메일은 발신 도메인과 공급자 설정을 확인한 뒤 명시적으로 켠다. STARTTLS 지원 SMTP가 필요하다.
# 암호화 키는 32바이트 난수를 Base64로 인코딩한 값이다. 실제 값은 커밋하지 않는다.
EMAIL_ENABLED=false
EMAIL_ENCRYPTION_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
