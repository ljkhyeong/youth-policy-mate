# k3s 환경변수로 주입할 예시. 앱이 이 파일을 자동으로 읽지는 않습니다.
# .example 주소와 빈 값은 실제 운영값으로 교체하세요. 프런트엔드에는 아래 웹 변수만 전달합니다.

# 웹 + API 공통: 같은 HTTPS 도메인, 마지막 / 제외
PUBLIC_APP_URL=https://policy.example.com

# 웹 전용: 클러스터 내부 Spring Service 주소
POLICY_API_BASE_URL=http://youth-policy-api:8080
HOSTNAME=0.0.0.0
PORT=3000

# API 전용: DB·인증·외부 공급자 비밀값을 웹 컨테이너에 전달하지 마세요.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_PORT=5432
DB_NAME=youth_policy_mate
DB_USER=youth_policy_mate
DB_PASSWORD=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ADMIN_MEMBER_IDS=

# Resend: 발신 도메인 인증과 웹훅 등록 후 활성화
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_ENCRYPTION_KEY=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# 정기 작업은 공급자 설정·한도 확인 후 활성화
REMINDERS_ENABLED=false
REMINDERS_DELIVERY_TIME=09:00
REMINDERS_POLL_MS=60000
ONTONG_API_KEY=
ONTONG_COLLECTION_SCHEDULE_ENABLED=false
ONTONG_COLLECTION_DAILY_LIMIT=0
ONTONG_COLLECTION_INTERVAL_SECONDS=0
ONTONG_COLLECTION_FIRST_PAGE=0
ONTONG_COLLECTION_LAST_PAGE=0
ONTONG_COLLECTION_CYCLE_SECONDS=0
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MONTHLY_LIMIT_WON=
AI_INPUT_WON_PER_MILLION=
AI_OUTPUT_WON_PER_MILLION=
AI_PRICING_VERSION=
AI_PRICING_VALID_UNTIL=
AI_MAX_OUTPUT_TOKENS=
AI_AUTO_ENABLED=false
AI_AUTO_DAILY_LIMIT=0
AI_AUTO_INTERVAL_SECONDS=300
AI_AUTO_MAX_ATTEMPTS=3
