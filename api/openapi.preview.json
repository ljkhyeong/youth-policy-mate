{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "인공 자료 조회와 정해진 예시 답변의 계산만 제공한다. 실제 정책·회원·저장·예약·발송 API가 아니다.",
    "title" : "청년정책메이트 개발 전용 인공 자료 API",
    "version" : "preview-1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/dev/eligibility-examples" : {
      "get" : {
        "description" : "고정 인공 규칙·답변을 기존 비교기와 집계 모델로 계산한다. 사용자 입력·저장·외부 호출 없이 preview 프로필에서만 제공한다.",
        "operationId" : "listDevelopmentEligibilityExamples",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EligibilityExamplesResponse"
                }
              }
            },
            "description" : "인공 자료의 자격·근거와 별도 모집 상태. 실제 정책 추천이나 자격 인증이 아니다."
          },
          "403" : {
            "description" : "preview 프로필이 아니면 접근 거부. 오류 본문은 사용하지 않는다."
          }
        },
        "summary" : "개발 전용 자격 판정 예시 조회",
        "tags" : [ "eligibility-preview-controller" ]
      }
    },
    "/api/dev/eligibility-trial" : {
      "get" : {
        "operationId" : "getDevelopmentEligibilityQuestions",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EligibilityQuestionsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "인공 재판정 질문과 답변 선택지 조회",
        "tags" : [ "eligibility-trial-controller" ]
      },
      "post" : {
        "description" : "정해진 질문 버전·답변 코드만 받는다. 실제 개인정보·저장·외부 호출 없이 계산한다. 답변의 질문 버전이 다르면 기존 비교기가 재확인을 요구한다.",
        "operationId" : "evaluateDevelopmentEligibilityAnswers",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EligibilityTrialRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EligibilityTrialResponse"
                }
              }
            },
            "description" : "인공 답변의 계산 결과"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TrialInputError"
                }
              }
            },
            "description" : "필수 값 누락 또는 지원하지 않는 답변 코드"
          }
        },
        "summary" : "인공 답변으로 자격 재판정",
        "tags" : [ "eligibility-trial-controller" ]
      }
    },
    "/api/dev/reminder-examples" : {
      "get" : {
        "description" : "입력·저장·발송 없이 고정 인공 신청기간을 서버 도메인 모델로 계산한다. preview 프로필에서만 제공한다.",
        "operationId" : "listDevelopmentReminderExamples",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReminderExamplesResponse"
                }
              }
            },
            "description" : "고정 인공 자료와 서버 계산 결과. 예약 완료를 뜻하지 않는다."
          },
          "403" : {
            "description" : "preview 프로필이 아닌 경우 접근 거부. 오류 본문은 사용하지 않는다."
          }
        },
        "summary" : "개발 전용 마감 알림 계산 예시 조회",
        "tags" : [ "reminder-preview-controller" ]
      }
    }
