{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "고정 인공 자료의 계산 결과 조회만 제공한다. 실제 정책·회원·예약·발송 API가 아니다.",
    "title" : "청년정책메이트 개발 전용 인공 자료 API",
    "version" : "preview-1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/dev/reminder-examples" : {
      "get" : {
        "description" : "입력·저장·발송 없이 고정 인공 신청기간을 서버 도메인 모델로 계산한다. preview 프로필에서만 제공한다.",
        "operationId" : "listDevelopmentReminderExamples",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReminderExamplesResponse"
                }
              }
            },
            "description" : "고정 인공 자료와 서버 계산 결과. 예약 완료를 뜻하지 않는다."
          },
          "403" : {
            "description" : "preview 프로필이 아닌 경우 접근 거부. 오류 본문은 사용하지 않는다."
          }
        },
        "summary" : "개발 전용 마감 알림 계산 예시 조회",
        "tags" : [ "reminder-preview-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApplicationPeriodResponse" : {
        "type" : "object",
        "description" : "기간 종류에 해당하지 않는 필드도 생략하지 않고 null로 보낸다. 날짜형과 시각형을 혼합하지 않는다.",
        "properties" : {
          "closesAtExclusive" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "TIMES의 마감 순간, 해당 순간부터 종료"
          },
          "closingTimeZone" : {
            "type" : [ "string", "null" ],
            "description" : "원래 마감 시간대 ID"
          },
          "endsOnInclusive" : {
            "type" : [ "string", "null" ],
            "format" : "date",
            "description" : "DATES의 종료일, 포함 경계. 정확한 시각이 아님"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "DATES", "TIMES", "ROLLING", "UNTIL_EXHAUSTED", "CLOSED", "UNRESOLVED" ]
          },
          "openingTimeZone" : {
            "type" : [ "string", "null" ],
            "description" : "원래 시작 시간대 ID"
          },
          "opensAtInclusive" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "TIMES의 시작 순간, 포함 경계"
          },
          "reason" : {
            "type" : [ "string", "null" ],
            "description" : "UNRESOLVED의 미확인 이유"
          },
          "startsOnInclusive" : {
            "type" : [ "string", "null" ],
            "format" : "date",
            "description" : "DATES의 시작일, 포함 경계"
          }
        },
        "required" : [ "closesAtExclusive", "closingTimeZone", "endsOnInclusive", "kind", "openingTimeZone", "opensAtInclusive", "reason", "startsOnInclusive" ]
      },
      "ReminderBasis" : {
        "type" : "object",
        "properties" : {
          "evaluatedAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "계산 기준 순간. 원문 수집 시각이 아님"
          },
          "evaluatedOnSeoul" : {
            "type" : "string",
            "format" : "date",
            "description" : "계산 기준 순간의 서울 날짜. 오늘 후보의 기준"
          },
          "policyId" : {
            "type" : "string"
          },
          "policyRevision" : {
            "type" : "string"
          },
          "sourceExcerpt" : {
            "type" : [ "string", "null" ],
            "description" : "기록된 발췌문. 없으면 null"
          },
          "sourceLocation" : {
            "type" : "string"
          },
          "sourceReference" : {
            "type" : "string"
          }
        },
        "required" : [ "evaluatedAt", "evaluatedOnSeoul", "policyId", "policyRevision", "sourceExcerpt", "sourceLocation", "sourceReference" ]
      },
      "ReminderCandidateDate" : {
        "type" : "object",
        "properties" : {
          "date" : {
            "type" : "string",
            "format" : "date",
            "description" : "서울의 달력 날짜. 발송 시각이 아님"
          },
          "daysBeforeDeadline" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "마감 며칠 전인지 나타내는 정수. 현재 후보 계산은 7·3·1일 전을 제공한다."
          },
          "status" : {
            "type" : "string",
            "enum" : [ "FUTURE_DATE", "TODAY_REQUIRES_SEND_TIME_CHECK" ]
          }
        },
        "required" : [ "date", "daysBeforeDeadline", "status" ]
      },
      "ReminderExample" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "result" : {
            "$ref" : "#/components/schemas/ReminderResultResponse"
          }
        },
        "required" : [ "description", "id", "label", "result" ]
      },
      "ReminderExamplesResponse" : {
        "type" : "object",
        "properties" : {
          "dataKind" : {
            "type" : "string",
            "enum" : [ "SYNTHETIC" ]
          },
          "examples" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ReminderExample"
            }
          }
        },
        "required" : [ "dataKind", "examples" ]
      },
      "ReminderRecruitment" : {
        "type" : "object",
        "properties" : {
          "explanation" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "BEFORE_OPENING", "OPEN", "CLOSED", "ROLLING", "UNTIL_EXHAUSTED", "UNKNOWN" ]
          }
        },
        "required" : [ "explanation", "status" ]
      },
      "ReminderResultResponse" : {
        "type" : "object",
        "properties" : {
          "applicationPeriod" : {
            "$ref" : "#/components/schemas/ApplicationPeriodResponse"
          },
          "basis" : {
            "$ref" : "#/components/schemas/ReminderBasis"
          },
          "dates" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ReminderCandidateDate"
            }
          },
          "deadlineOnSeoul" : {
            "type" : [ "string", "null" ],
            "format" : "date",
            "description" : "확인된 마감의 서울 날짜. 없으면 null이며 임의의 마감일을 만들지 않는다."
          },
          "explanation" : {
            "type" : "string"
          },
          "outcome" : {
            "type" : "string",
            "enum" : [ "CANDIDATES_AVAILABLE", "NO_CONFIRMED_DEADLINE", "RECRUITMENT_CLOSED", "NO_REMAINING_DATES" ]
          },
          "recruitment" : {
            "$ref" : "#/components/schemas/ReminderRecruitment"
          }
        },
        "required" : [ "applicationPeriod", "basis", "dates", "deadlineOnSeoul", "explanation", "outcome", "recruitment" ]
      }
    }
  }
}
