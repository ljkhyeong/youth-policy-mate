{
  "name": "youth-policy-mate",
  "private": true,
  "workspaces": ["frontend"],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "dev:backend": "./backend/gradlew -p backend bootRun --no-daemon --args='--spring.profiles.active=local'",
    "dev:preview-api": "./backend/gradlew -p backend bootRun --no-daemon --args='--spring.profiles.active=preview'",
    "generate:api": "./backend/gradlew -p backend exportPreviewOpenApi --no-daemon && npm run generate:api-types --workspace frontend",
    "check:api-types": "npm run check:api-types --workspace frontend",
    "test:preview-api": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.devpreview.*' --no-daemon",
    "build:web": "npm run build --workspace frontend",
    "check:web": "npm run lint --workspace frontend && npm run typecheck --workspace frontend",
    "test:web": "npm run test --workspace frontend",
    "test:eligibility": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.eligibility.*' --no-daemon",
    "test:recruitment": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.Recruitment*' --no-daemon",
    "test:policy-revisions": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.PolicyRevisionStateTest' --no-daemon",
    "test:reminders": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.schedule.*' --no-daemon",
    "check:backend": "./backend/gradlew -p backend build --no-daemon",
    "check:tools": "node --test scripts/ontong-api-probe.test.mjs",
    "probe:ontong": "node --env-file-if-exists=.env scripts/ontong-api-probe.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  }
}
