{
  "name": "youth-policy-mate",
  "private": true,
  "workspaces": ["frontend"],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "compile:backend": "./backend/gradlew -p backend classes testClasses --no-daemon",
    "package:backend": "./backend/gradlew -p backend bootJar --no-daemon",
    "test:policy-questions": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.catalog.*RulesTest' --no-daemon",
    "dev:web": "npm run dev --workspace frontend",
    "dev:backend": "./backend/gradlew -p backend bootRun --no-daemon --args='--spring.profiles.active=local'",
    "dev:preview-api": "./backend/gradlew -p backend bootRun --no-daemon --args='--spring.profiles.active=preview'",
    "generate:api": "./backend/gradlew -p backend exportPreviewOpenApi exportPolicyOpenApi --no-daemon && npm run generate:api-types --workspace frontend",
    "import:policy": "./backend/gradlew -p backend importPolicyCapture --no-daemon",
    "collect:policy": "./backend/gradlew -p backend collectPolicyPage --no-daemon",
    "test:policy-collection": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.Ontong*Test' --tests 'kr.youthpolicymate.policy.catalog.PolicyCatalogTest' --no-daemon",
    "test:policy-catalog": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.OntongPolicyCaptureTest' --tests 'kr.youthpolicymate.policy.catalog.PolicyCatalogTest' --no-daemon",
    "check:api-types": "npm run check:api-types --workspace frontend",
    "test:preview-api": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.devpreview.*' --no-daemon",
    "build:web": "npm run build --workspace frontend",
    "check:web": "npm run lint --workspace frontend && npm run typecheck --workspace frontend",
    "test:web": "npm run test --workspace frontend",
    "test:eligibility": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.eligibility.*' --no-daemon",
    "test:recruitment": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.Recruitment*' --no-daemon",
    "test:policy-revisions": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.PolicyRevisionStateTest' --no-daemon",
    "test:ingestion": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.CollectionRunTest' --tests 'kr.youthpolicymate.ingestion.PolicyAiCandidateStateTest' --tests 'kr.youthpolicymate.ingestion.PolicyAiCandidateResultProjectorTest' --tests 'kr.youthpolicymate.ingestion.PolicyAiRequestAdmissionTest' --tests 'kr.youthpolicymate.ingestion.AiReservationRecoveryRetryPolicyTest' --no-daemon",
    "test:ai-candidates": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiCandidateStateTest' --no-daemon",
    "test:ai-candidate-projection": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiCandidateResultProjectorTest' --no-daemon",
    "test:ai-admission": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRequestAdmissionTest' --no-daemon",
    "test:ai-reservations": "npm run test:ai-reservation-db",
    "test:ai-reservation-db": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.AiBudgetReservationStoreTest' --no-daemon",
    "test:ai-execution": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiExecutionCoordinatorTest' --no-daemon",
    "test:ai-recovery": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.AiReservationRecoveryStoreTest' --no-daemon",
    "test:ai-recovery-execution": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRecoveryCoordinatorTest' --no-daemon",
    "test:ai-recovery-heartbeat": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRecoveryHeartbeat*Test' --no-daemon",
    "test:ai-recovery-policy": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.AiReservationRecoveryRetryPolicyTest' --no-daemon",
    "test:ai-recovery-operations": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.AiReservationRecoveryOperationsQueryTest' --no-daemon",
    "test:ai-recovery-work": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.AiReservationRecoveryWork*Test' --no-daemon",
    "test:reminders": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.schedule.*' --no-daemon",
    "check:backend": "./backend/gradlew -p backend build --no-daemon",
    "check:tools": "node --test scripts/*.test.mjs",
    "probe:ontong": "node --env-file-if-exists=.env scripts/ontong-api-probe.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  }
}
