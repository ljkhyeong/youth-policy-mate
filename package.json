{
  "name": "youth-policy-mate",
  "private": true,
  "workspaces": ["frontend"],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "compile:backend": "./backend/gradlew -p backend classes testClasses --no-daemon",
    "package:backend": "./backend/gradlew -p backend bootJar --no-daemon",
    "test:policy-questions": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.catalog.*RulesTest' --no-daemon",
    "dev:web": "npm run dev --workspace frontend",
    "dev:backend": "./backend/gradlew -p backend bootRun --no-daemon --args='--spring.profiles.active=local'",
    "generate:api": "./backend/gradlew -p backend exportPolicyOpenApi --no-daemon && npm run generate:api-types --workspace frontend",
    "ai:policy-rules": "./backend/gradlew -p backend managePolicyAiRules --no-daemon",
    "ai:costs": "./backend/gradlew -p backend queryOpenAiCosts --no-daemon",
    "test:ai-costs": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.OpenAiCostsTest' --no-daemon",
    "test:ai-rule-drafts": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleDraftStoreTest' --no-daemon",
    "test:ai-rule-generation": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleGenerationTest' --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleDraftStoreTest' --no-daemon",
    "test:ai-rule-auto": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleGenerationTest' --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleSchedulerTest' --no-daemon",
    "test:admin-ai": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.admin.PolicyAiRunApiTest' --tests 'kr.youthpolicymate.config.AdminAccessTest' --no-daemon",
    "rules:policy": "./backend/gradlew -p backend managePolicyRules --no-daemon",
    "collect:policy": "./backend/gradlew -p backend collectPolicyPage --no-daemon",
    "test:policy-collection": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.Ontong*Test' --tests 'kr.youthpolicymate.policy.catalog.PolicyCatalogTest' --no-daemon",
    "test:policy-catalog": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.OntongPolicyCaptureTest' --tests 'kr.youthpolicymate.policy.catalog.PolicyCatalogTest' --no-daemon",
    "test:admin-collection": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.admin.CollectionExceptionApiTest' --tests 'kr.youthpolicymate.admin.CollectionReplayApiTest' --tests 'kr.youthpolicymate.admin.PolicyCorrectionApiTest' --tests 'kr.youthpolicymate.admin.PolicyRuleReviewApiTest' --tests 'kr.youthpolicymate.config.AdminAccessTest' --no-daemon",
    "check:api-types": "npm run check:api-types --workspace frontend",
    "build:web": "npm run build --workspace frontend",
    "check:web": "npm run lint --workspace frontend && npm run typecheck --workspace frontend",
    "test:web": "npm run test --workspace frontend",
    "test:recruitment": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.policy.Recruitment*' --no-daemon",
    "test:ai-reservation-db": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.ingestion.PolicyAiRuleCallStoreTest' --no-daemon",
    "test:member-login": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.member.OAuthLoginFlowTest' --tests 'kr.youthpolicymate.member.SocialMemberServiceTest' --no-daemon",
    "test:admin-email": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.admin.EmailDeliveryApiTest' --no-daemon",
    "test:email": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.member.*TransportTest' --tests 'kr.youthpolicymate.member.MemberFlowTest' --no-daemon",
    "email:rotate-key": "./backend/gradlew -p backend rotateEmailKey --no-daemon",
    "test:email-key-rotation": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.member.EmailKeyRotationTest' --no-daemon",
    "test:runtime": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.config.ProductionRuntimeTest' --no-daemon",
    "test:member-flow": "./backend/gradlew -p backend test --tests 'kr.youthpolicymate.member.MemberFlowTest' --no-daemon",
    "check:backend": "./backend/gradlew -p backend build --no-daemon",
    "check:tools": "node --test scripts/*.test.mjs",
    "probe:ontong": "node --env-file-if-exists=.env scripts/ontong-api-probe.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:verify-backup": "node scripts/db-backup.mjs verify",
    "test:db-backup": "node --test scripts/db-backup.integration.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  }
}
